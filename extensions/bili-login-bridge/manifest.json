{
  "manifest_version": 3,
  "name": "Memoria Bilibili 登录桥",
  "version": "1.1.0",
  "description": "由本机 Memoria 页面手动导入当前 Chrome 的 Bilibili 登录。",
  "key": "",
  "permissions": ["cookies"],
  "host_permissions": ["https://www.bilibili.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "externally_connectable": {
    "matches": ["http://127.0.0.1/*"]
  }
}
